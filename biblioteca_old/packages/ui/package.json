{
  "name": "@alexandretorqueti/biblioteca-global-ui",
  "version": "0.1.19",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run build:js && npm run build:types",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@mui/x-date-pickers": "^9.10.1",
    "dayjs": "^1.11.21",
    "react": "^19.0.0 || ^19.1.1 || ^19.2.8",
    "react-dom": "^19.0.0 || ^19.1.1 || ^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandretorqueti/biblioteca_global.git",
    "directory": "packages/ui"
  }
}
