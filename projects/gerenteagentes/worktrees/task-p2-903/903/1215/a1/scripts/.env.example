# Credenciais da migração Postgres → MySQL (scripts/migrate-postgres-to-mysql.cjs)
#
# 1. Copie este arquivo para .env (na MESMA pasta scripts/):
#      cp scripts/.env.example scripts/.env
# 2. Preencha com os valores reais dos containers:
#      - Postgres: docker inspect global-ia-postgres (env POSTGRES_USER/PASSWORD/DB)
#      - MySQL:    docker inspect biblioteca-global-mysql (env MYSQL_USER/PASSWORD)
# 3. Restrinja o acesso:  chmod 600 scripts/.env
#
# ⚠️ O .env é ignorado pelo git (scripts/.gitignore) — NUNCA commite credenciais.
#    O script falha rápido se alguma variável abaixo estiver ausente.

# ── Postgres (origem — banco legado do motor/Isa) ─────────────────────────────
PG_HOST=192.168.1.16
PG_PORT=5432
PG_USER=globalia
PG_PASSWORD=sua_senha_aqui
PG_DATABASE=globalia

# ── MySQL (destino — database projeto_<slug> da biblioteca) ──────────────────
MYSQL_HOST=192.168.1.16
MYSQL_PORT=3308
MYSQL_USER=biblioteca
MYSQL_PASSWORD=sua_senha_aqui
MYSQL_DATABASE=projeto_gerenteagentes
