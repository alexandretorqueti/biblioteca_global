# BEGIN BIBLIOTECA-GLOBAL-BLUE-GREEN
# Este bloco é gerenciado pelo deploy-blue-green.sh.

server {
    listen 80;
    server_name biblioteca.globaltecnologia.net;

    location / {
        proxy_pass http://host.docker.internal:__WEB_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 80;
    # O hostname antigo continua sendo usado pelo front já publicado no
    # Cloudflare Pages. Mantê-lo como alias evita quebrar clientes durante a
    # migração para api.biblioteca.globaltecnologia.net.
    server_name api.biblioteca.globaltecnologia.net biblioteca-api.webconnect.com.br;

    location / {
        proxy_pass http://host.docker.internal:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# END BIBLIOTECA-GLOBAL-BLUE-GREEN
