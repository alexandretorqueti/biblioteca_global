{
  "_comment": "Exemplo de configuração do OpenClaw para integrar o WebAI Provider",
  "_instructions": "Adicione esta configuração ao seu openclaw.json existente (merge com providers existentes)",
  
  "models": {
    "mode": "merge",
    "providers": {
      "webai": {
        "baseUrl": "http://localhost:3100/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "gemini",
            "name": "Google Gemini (via Chrome)",
            "contextWindow": 1000000,
            "maxTokens": 8192
          },
          {
            "id": "gpt",
            "name": "ChatGPT (via Chrome)",
            "contextWindow": 128000,
            "maxTokens": 4096
          },
          {
            "id": "claude",
            "name": "Claude (via Chrome)",
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      }
    }
  }
}
