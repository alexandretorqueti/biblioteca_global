# GerenteAgentes — variáveis de ambiente (copie para .env e ajuste).

# Database MySQL (mesmo credentials do core, mas database separado)
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=biblioteca
MYSQL_PASSWORD=troque…alor
MYSQL_DATABASE=projeto_640

# JWT (se necessário para autenticação interna)
JWT_SECRET=troque…redo
JWT_ACCESS_EXPIRATION=2h
JWT_REFRESH_EXPIRATION=7d

# URL do Console OpenClaw
OPENCLAW_CONSOLE_URL=http://host.docker.internal:6280
OPENCLAW_CONSOLE_TOKEN=

# URL do API (motor-v3)
API_URL=http://host.docker.internal:3001
