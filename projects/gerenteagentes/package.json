{
  "name": "@biblioteca-global/project-gerenteagentes",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Projeto gerenteagentes — piloto para gerenciamento de agentes de IA",
  "main": "src/index.ts",
  "scripts": {
    "pretest": "cd motor-v2 && ([ -d node_modules ] || npm install --include=dev)",
