    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@biblioteca-global/schema-tools": "*",
    "@biblioteca-global/shared": "*",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.23.3"
  }
}
