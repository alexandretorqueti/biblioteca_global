{
  "name": "@biblioteca-global/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Biblioteca de componentes UI da Biblioteca Global (React 19 + MUI 7)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run clean && vite build && npm run build:types",
    "clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@biblioteca-global/shared": "*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@mui/x-date-pickers": "^9.10.1",
    "@uiw/react-json-view": "^1.12.2",
    "dayjs": "^1.11.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
