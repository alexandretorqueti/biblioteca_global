# Biblioteca Global v2 — variáveis de ambiente (copie para .env e ajuste).
# NUNCA commitar o .env real (já coberto pelo .gitignore).

# ── Banco (MySQL 8 via docker-compose.yml) ─────────────────────────────
# Host visto pela API rodando FORA do docker (dev local).
MYSQL_HOST=localhost
# Porta no HOST. 3307 já é do MySQL do Recrescer — usar 3308.
MYSQL_PORT=3308
MYSQL_USER=biblioteca
MYSQL_PASSWORD=troque…alor
MYSQL_ROOT_PASSWORD=troqu…alor
# Database sistêmico da plataforma (usuarios, projetos, pivot, refresh_tokens).
MYSQL_DATABASE=core

# ── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=troque…redo

# ── Auth por código (passwordless) ────────────────────────────────────
# Segredo HMAC dos códigos de verificação — obrigatório em produção.
AUTH_CODE_SECRET=DEFINA-EM-PRODUCAO
# TTL do código em ms (padrão: 10 min).
AUTH_CODE_TTL_MS=600000
# Máximo de tentativas de verificação por código (estouro invalida).
AUTH_MAX_ATTEMPTS=5
# Rate-limit de pedidos de código por e-mail/IP na janela.
AUTH_RATE_LIMIT_MAX=3
AUTH_RATE_LIMIT_WINDOW_MS=900000
# TTL do token efêmero emitido no verify-code (1ª vez, sem senha).
AUTH_VERIFY_TOKEN_TTL=5m
# APENAS DEBUG: loga o código no log quando SMTP não configurado
# (validação manual). NUNCA ligar em produção.
AUTH_CODE_DEBUG_LOG=false

# ── E-mail (SMTP) — envio do código de verificação ─────────────────────
# Sem SMTP configurado em dev, a API responde sem enviar (falha leve).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@globaltecnologia.com.br

# ── Provisionamento (token de serviço) ────────────────────────────────
# Header Authorization: Bearer <PROVISION_TOKEN> — usado pelo GerenteAgentes.
PROVISION_TOKEN=DEFINA-EM-PRODUCAO

# ── Portas dos serviços ────────────────────────────────────────────────
# apps/api (NestJS)
API_PORT=3001
# apps/web (Vite)
WEB_PORT=5173
# Portas publicadas pelo compose no host.
API_HOST_PORT=3003
WEB_HOST_PORT=5174
