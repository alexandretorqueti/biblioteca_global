{
  "name": "@alexandretorqueti/biblioteca-global-ui",
  "private": false,
  "version": "0.1.9",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @global/documentacao --",
    "build": "npm run build --workspaces --if-present",
