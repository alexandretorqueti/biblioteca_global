{
  "name": "biblioteca-global",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma Biblioteca Global — geração de sistemas a partir de configuração (v2)",
  "workspaces": [
    "packages/*",
    "apps/*",
    "projects/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p database",
    "db:generate": "drizzle-kit generate --config database/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config database/drizzle.config.ts",
    "db:seed": "tsx database/seed.ts",
    "db:generate:documentacao": "drizzle-kit generate --config projects/documentacao/drizzle.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "jiti": "^2.7.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.23.3"
  }
}
