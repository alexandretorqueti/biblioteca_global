{
  "name": "biblioteca-global",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @global/documentacao --",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace @alexandretorqueti/biblioteca-global-ui",
    "preview": "npm run preview --workspace @global/documentacao"
  }
}
