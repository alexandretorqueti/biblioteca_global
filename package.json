{
  "name": "biblioteca-global",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma Biblioteca Global — geração de sistemas a partir de configuração (v2)",
  "workspaces": [
    "packages/*",
    "apps/*",
    "projects/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
